<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers Condition="'$(MSBuildProjectExtension)' == '.csproj'">win-x64</RuntimeIdentifiers>
    <Authors>RigPilot contributors</Authors>
    <!-- Company and Product populate the Win32 version resource (CompanyName/ProductName)
         on every binary. Present publisher metadata reduces "unknown publisher" antivirus
         heuristics and is asserted by scripts\Test-DistributionHygiene.ps1. -->
    <Company>RigPilot contributors</Company>
    <Product>RigPilot</Product>
    <Copyright>Copyright (c) RigPilot contributors</Copyright>
    <RepositoryUrl>https://github.com/NiccTM/rigpilot</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.8.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">beta.1</VersionSuffix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
  </PropertyGroup>
</Project>
